# ══════════════════════════════════════════════════════════════════════════════
# Investment Assistant – Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production          # development | production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Security – VPN-only access ────────────────────────────────────────────────
# The default deployment is reachable only through WireGuard. Do not add a LAN
# CIDR unless you consciously want to bypass the VPN at home.
ALLOWED_IPS=10.8.0.0/24
TRUST_PROXY_HEADERS=true

# ── Browser authentication ───────────────────────────────────────────────────
# These bootstrap the first local account. Generate all three with:
# python3 scripts/create_auth_hash.py
# Add further accounts privately with: python3 scripts/create_user.py
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_MINUTES=480
AUTH_REQUIRE_LOGIN=true
AUTH_COOKIE_SECURE=true
MAX_CHAT_MESSAGE_CHARS=8000

# Optional MCP bridge. Keep disabled unless you explicitly need a separate
# local client, and use a long random bearer token.
MCP_ENABLED=false
MCP_AUTH_TOKEN=

# ── LLM Backend (local, in-process — no external APIs) ───────────────────────
# Prompts and reasoning stay on your hardware. Market/news and broker connectors
# are separate, explicit network egress paths described below.
# GGUF quantised models via llama-cpp-python are CPU-optimised for Pi 5.

# ── llama_cpp settings ────────────────────────────────────────────────────────
# Absolute path to the GGUF file.  Download with:
#   python3 scripts/download_model.py --list     # see available presets
#   python3 scripts/download_model.py qwen2.5-7b # download one
#
# Tested on Pi 5 (8 GB RAM):
#   qwen2.5-7b-instruct-q4_k_m.gguf   ~4.7 GB  ← best quality/speed trade-off
#   llama-3.2-3b-instruct-q8_0.gguf   ~3.4 GB  ← faster, lower RAM
#   mistral-7b-instruct-q4_k_m.gguf   ~4.4 GB  ← solid all-rounder
LLM_MODEL_PATH=/app/models/qwen2.5-7b-instruct-q4_k_m.gguf
LLM_CONTEXT_SIZE=4096
LLM_N_GPU_LAYERS=0                  # 0 = CPU only (Pi 5 has no GPU)
LLM_N_THREADS=4                     # Pi 5 has 4 CPU cores
LLM_N_BATCH=128                     # lower if you see memory pressure

# ── Shared inference settings ─────────────────────────────────────────────────
AGENT_MAX_TOKENS=2048               # lower = faster on Pi 5
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_TOOL_RESULT_CHARS=12000

# ── Trading Mode ──────────────────────────────────────────────────────────────
# recommend  → agent proposes trades, you confirm via chat
# auto       → agent executes only bounded, configured trades automatically
TRADING_MODE=recommend

# Auto-mode safety limits (only used when TRADING_MODE=auto)
AUTO_MAX_TRADE_USD=500          # Max USD value per single trade
AUTO_DAILY_LOSS_LIMIT_USD=1000  # Stop auto-trading if daily loss exceeds this
AUTO_ALLOWED_SYMBOLS=           # Comma-separated; empty = all symbols allowed
AUTO_ALLOW_MARKET_ORDERS=false  # Safer default: auto mode requires a limit price
LIVE_TRADING_ENABLED=false      # Must be explicitly enabled for live-money routes
AUTONOMOUS_SCANS_ENABLED=true
AUTONOMOUS_SCAN_INTERVAL_MINUTES=60

# ── Database – PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=investment_assistant
POSTGRES_USER=ia_user
POSTGRES_PASSWORD=change_me_strong_password

# ── Alpaca Markets ────────────────────────────────────────────────────────────
# Get keys at: https://app.alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true               # true = paper trading, false = live

# ── Interactive Brokers ───────────────────────────────────────────────────────
# Requires IB Gateway running separately (see docs/ibkr-gateway.md)
IBKR_HOST=host.docker.internal  # or 127.0.0.1 if running on host
IBKR_PORT=4002                  # 4001 = live, 4002 = paper
IBKR_CLIENT_ID=1
IBKR_ENABLED=false              # set true once IB Gateway is configured

# ── Coinbase Advanced Trade ───────────────────────────────────────────────────
# Get keys at: https://www.coinbase.com/settings/api
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ── Binance ───────────────────────────────────────────────────────────────────
# Get keys at: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true            # true = testnet, false = live

# ── News adapters ─────────────────────────────────────────────────────────────
# Public RSS/HTML scraping is the default and needs no keys. Optional API
# adapters remain available for compatibility but are disabled by default.
NEWS_API_ADAPTERS_ENABLED=false
NEWSAPI_KEY=
GUARDIAN_API_KEY=

# ── Newsletter Email Ingestion (optional IMAP) ───────────────────────────────
NEWSLETTER_IMAP_SERVER=imap.gmail.com
NEWSLETTER_IMAP_PORT=993
NEWSLETTER_EMAIL_USER=
NEWSLETTER_EMAIL_PASSWORD=
NEWSLETTER_SENDER_FILTER=

# ── Scheduler ────────────────────────────────────────────────────────────────
# How often to refresh market data (in minutes; the scheduler runs 24/7)
MARKET_DATA_REFRESH_MINUTES=5
NEWS_INGESTION_MINUTES=60
# Day of week for weekly report (0=Monday … 6=Sunday) and time (UTC)
WEEKLY_REPORT_DAY=6             # Sunday
WEEKLY_REPORT_HOUR=18
WEEKLY_REPORT_MINUTE=0

# ── Reports ───────────────────────────────────────────────────────────────────
REPORTS_DIR=/app/reports        # inside the container

# ── Pi-hole ───────────────────────────────────────────────────────────────────
PIHOLE_PASSWORD=change_me_pihole_password
TZ=Europe/Lisbon                # your timezone (used by Pi-hole)
